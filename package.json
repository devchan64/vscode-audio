{
  "name": "vscode-audio-wave-editor",
  "displayName": "Audio Wave Editor",
  "description": "Waveform and basic audio editing for WAV, MP3, and Web Audio-compatible formats.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onCommand:audioWaveEditor.open"],
  "main": "./extension.js",
  "contributes": {
    "commands": [{ "command": "audioWaveEditor.open", "title": "Audio Wave Editor: Open" }]
  },
  "scripts": {
    "check": "node --check extension.js && node --check test/e2e/runTest.js && node --check test/e2e/suite/index.js",
    "test:e2e": "node test/e2e/runTest.js",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.2",
    "mocha": "^11.7.2"
  }
}
